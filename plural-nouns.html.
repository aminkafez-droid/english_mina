<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Plural nouns: тренажёр</title>
<style>
:root{--bg:#faf7fc;--card:#fff;--ink:#2a2035;--mute:#6d6379;--pur:#6b3a8c;--soft:#efe3f6;--ok:#1e7a46;--okbg:#dff3e6;--bad:#b3261e;--badbg:#fbe3e1;--org:#f6c9b5;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1c1624;--card:#272031;--ink:#f1eaf6;--mute:#a99db6;--pur:#c9a0e6;--soft:#3a2d48;--ok:#7fd9a3;--okbg:#1f3a2b;--bad:#ff9a92;--badbg:#44211f;--org:#5a3a2c}}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 "Nunito","Segoe UI",system-ui,sans-serif}
main{max-width:640px;margin:0 auto;padding:20px 16px 48px}
h1{font:800 34px/1.1 "Georgia","Times New Roman",serif;margin:8px 0 4px;color:var(--pur)}
.sub{color:var(--mute);margin:0 0 18px}
nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
nav button{border:2px solid var(--pur);background:transparent;color:var(--pur);border-radius:999px;padding:7px 14px;font:inherit;font-weight:700;cursor:pointer}
nav button[aria-selected=true]{background:var(--pur);color:var(--bg)}
nav small{font-weight:600;opacity:.8}
.card{background:var(--card);border:2px solid var(--pur);border-radius:20px;padding:20px}
.rules{display:grid;gap:8px;margin:0;padding:0;list-style:none}
.rules li{background:var(--soft);border-radius:12px;padding:10px 14px}
.rules b{color:var(--pur)}
.ex{color:var(--mute);font-style:italic}
.q{font-size:22px;font-weight:700;margin:6px 0 14px}
.q em{color:var(--pur)}
.prog{height:8px;background:var(--soft);border-radius:8px;overflow:hidden;margin-bottom:14px}
.prog i{display:block;height:100%;background:var(--pur);transition:width .3s}
input[type=text]{width:100%;font:inherit;font-size:20px;padding:10px 14px;border:2px solid var(--pur);border-radius:12px;background:var(--bg);color:var(--ink)}
.opts{display:grid;gap:8px}
.opt{text-align:left;font:inherit;padding:10px 14px;border:2px solid var(--soft);background:var(--bg);color:var(--ink);border-radius:12px;cursor:pointer}
.opt:hover:not(:disabled){border-color:var(--pur)}
.opt.ok{background:var(--okbg);border-color:var(--ok)}
.opt.bad{background:var(--badbg);border-color:var(--bad)}
.fb{margin-top:14px;padding:10px 14px;border-radius:12px;min-height:0}
.fb.ok{background:var(--okbg);color:var(--ok)}
.fb.bad{background:var(--badbg);color:var(--bad)}
.row{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
.btn{font:inherit;font-weight:800;border:0;border-radius:12px;padding:11px 20px;background:var(--pur);color:var(--bg);cursor:pointer}
.btn.ghost{background:transparent;border:2px solid var(--pur);color:var(--pur)}
.score{font:800 56px/1 Georgia,serif;color:var(--pur);margin:10px 0}
:focus-visible{outline:3px solid var(--pur);outline-offset:2px}
</style>
</head>
<body>
<main>
<h1>Posh and Becks</h1>
<p class="sub">Множественное число существительных: правила и тренировка</p>
<nav id="tabs" role="tablist"></nav>
<section id="view"></section>
</main>
<script>
const RULES=[
["a","Обычное правило: добавляем -s","brother → brothers"],
["b","После -s, -sh, -ch, -z, -x добавляем -es","bus → buses, dish → dishes, watch → watches, box → boxes"],
["c","После -o добавляем -s или иногда -es","photo → photos, potato → potatoes"],
["d","Согласная + -y: меняем -y на -ies","party → parties"],
["e","Гласная + -y: добавляем -s","holiday → holidays"],
["f","На -f или -fe: меняем на -ves","shelf → shelves"],
["g","Исключения (неправильные формы)","foot → feet, man → men, woman → women"]
];
const T=(q,a,e)=>({t:"t",q,a:[].concat(a),e});
const C=(q,o,a,e)=>({t:"c",q,o,a,e});
const RO=["a","b","c","d","e","f","g"].map(x=>x+" — "+RULES["abcdefg".indexOf(x)][1]);
const R=(w,k,e)=>C("Какое правило у слова <em>"+w+"</em>?",RO,"abcdefg".indexOf(k),e);
const UO=["Всегда во мн. числе","Нет мн. числа (неисчисляемое)","Обычное исчисляемое"];
const U=(w,i,e)=>C("Слово <em>"+w+"</em>:",UO,i,e);
const S=(a,b,c,i,e)=>C("Выберите верный вариант:",[a,b,c],i,e);
const SECTIONS=[
{n:"Правила",rules:true},
{n:"Напишите мн. число",items:[
T("uncle","uncles","Правило a"),T("address","addresses","Правило b: -ss + es"),T("day","days","Правило e: гласная + y"),T("video","videos","Правило c: -s"),T("match","matches","Правило b: -ch + es"),
T("life","lives","Правило f: -fe → -ves"),T("lady","ladies","Правило d: согласная + y"),T("tooth","teeth","Исключение (g)"),T("mother","mothers","Правило a"),T("knife","knives","Правило f"),
T("potato","potatoes","Правило c: -es"),T("child","children","Исключение (g)"),T("box","boxes","Правило b"),T("woman","women","Исключение (g)"),T("party","parties","Правило d")]},
{n:"Какое правило?",items:[
R("wife","f","wife → wives"),R("jacket","a","jackets"),R("company","d","company → companies"),R("dress","b","dresses"),R("boy","e","boys"),
R("hero","c","heroes — вариант с -es"),R("shelf","f","shelf → shelves"),R("person","g","person → people"),R("watch","b","watches"),R("party","d","parties")]},
{n:"Найди ошибку",items:[
S("My jeans is very old.","My jeans are very old.","My jean is very old.",1,"Jeans всегда во мн. числе, глагол — are."),
S("Put the knifes and forks on the table.","Put the knives and forks on the table.","Put the knifes and forkes on the table.",1,"knife → knives."),
S("I love babys.","I love babies.","I love babyes.",1,"Согласная + y → -ies."),
S("I’d like some informations about trains.","I’d like some informations about train.","I’d like some information about trains.",2,"Information — неисчисляемое, без -s."),
S("Can I see some photoes of your family?","Can I see some photos of your family?","Can I see some photo of your family?",1,"photo → photos."),
S("I’ve got two watches.","I’ve got two watchs.","I’ve got two watchies.",0,"Это предложение верное: watch → watches."),
S("She’s got very big foots.","She’s got very big feet.","She’s got very big feets.",1,"foot → feet."),
S("I’ve got lots of homeworks this evening.","I’ve got lots of homework this evening.","I’ve got lots of homework’s this evening.",1,"Homework — неисчисляемое.")]},
{n:"Исчисляемые?",items:[
U("scissors",0,"Scissors, trousers — всегда мн. число."),U("homework",1,"Homework — без мн. числа."),U("information",1,"Information — без мн. числа."),
U("trousers",0,"Всегда мн. число."),U("luggage",1,"Luggage — без мн. числа."),U("advice",1,"Advice — без мн. числа."),
U("jeans",0,"Всегда мн. число."),U("sunglasses",0,"Всегда мн. число."),U("help",1,"Help — без мн. числа."),U("tattoo",2,"tattoo → tattoos")]}
];
let cur=0,st=SECTIONS.map(()=>({i:0,s:0,done:false,order:null}));
const $=id=>document.getElementById(id);
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function tabs(){
 $("tabs").innerHTML=SECTIONS.map((s,i)=>{
  const x=st[i];const p=s.items?` <small>${x.done?x.s+"/"+s.items.length:""}</small>`:"";
  return `<button role="tab" aria-selected="${i==cur}" onclick="go(${i})">${s.n}${p}</button>`}).join("");
}
function go(i){cur=i;tabs();render()}
function render(){
 const s=SECTIONS[cur],x=st[cur],v=$("view");
 if(s.rules){
  v.innerHTML=`<div class="card"><ul class="rules">${RULES.map(r=>`<li><b>${r[0]}</b> ${r[1]}<br><span class="ex">${r[2]}</span></li>`).join("")}</ul>
  <p>Неисчисляемые слова не имеют мн. числа: <i>homework, information, luggage, help, advice</i>. Некоторые слова всегда во мн. числе: <i>scissors, trousers, jeans</i>.</p>
  <div class="row"><button class="btn" onclick="go(1)">Начать тренировку</button></div></div>`;return}
 if(!x.order)x.order=shuffle(s.items);
 if(x.i>=x.order.length){
  x.done=true;tabs();
  const pct=x.s/x.order.length;
  v.innerHTML=`<div class="card"><p>Результат</p><div class="score">${x.s} / ${x.order.length}</div>
  <p>${pct==1?"Отлично, без единой ошибки!":pct>=.7?"Хорошо! Повторите правила для ошибок.":"Загляните во вкладку «Правила» и попробуйте ещё раз."}</p>
  <div class="row"><button class="btn" onclick="again()">Ещё раз</button>${cur<SECTIONS.length-1?`<button class="btn ghost" onclick="go(${cur+1})">Следующее задание</button>`:""}</div></div>`;return}
 const q=x.order[x.i];
 let body="";
 if(q.t=="t")body=`<div class="q">Plural of <em>${q.q}</em>:</div><input type="text" id="inp" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Ответ"><div class="row"><button class="btn" id="chk" onclick="checkT()">Проверить</button></div>`;
 else{q.idx=shuffle(q.o.map((_,i)=>i));body=`<div class="q">${q.q}</div><div class="opts">${q.idx.map(i=>`<button class="opt" onclick="pick(${i},this)">${q.o[i]}</button>`).join("")}</div>`}
 v.innerHTML=`<div class="card"><div class="prog"><i style="width:${x.i/x.order.length*100}%"></i></div>${body}<div id="fb" class="fb" hidden></div><div class="row"><button class="btn" id="nx" onclick="next()" hidden>Дальше</button></div></div>`;
 const inp=$("inp");if(inp){inp.focus();inp.addEventListener("keydown",e=>{if(e.key=="Enter"){$("nx").hidden?checkT():next()}})}
}
function fb(ok,t){const f=$("fb");f.hidden=false;f.className="fb "+(ok?"ok":"bad");f.textContent=t;$("nx").hidden=false;$("nx").focus();if(ok)st[cur].s++}
function checkT(){
 const q=st[cur].order[st[cur].i],inp=$("inp");if(!inp.value.trim())return;
 const ok=q.a.includes(inp.value.trim().toLowerCase());inp.disabled=true;$("chk").hidden=true;
 fb(ok,(ok?"Верно! ":"Правильно: "+q.a[0]+". ")+q.e);
}
function pick(i,b){
 const q=st[cur].order[st[cur].i],bs=document.querySelectorAll(".opt");
 bs.forEach(x=>x.disabled=true);
 const ok=i==q.a;b.classList.add(ok?"ok":"bad");
 if(!ok)bs.forEach((x,k)=>{if(q.idx[k]==q.a)x.classList.add("ok")});
 fb(ok,(ok?"Верно! ":"Не совсем. ")+q.e);
}
function next(){st[cur].i++;render()}
function again(){st[cur]={i:0,s:0,done:false,order:null};tabs();render()}
tabs();render();
</script>
</body>
</html>
